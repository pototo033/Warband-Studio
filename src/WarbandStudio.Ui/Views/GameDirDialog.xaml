<Window x:Class="WarbandStudio.Ui.Views.GameDirDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择《全面战争：战锤3》游戏目录" SizeToContent="Height" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}">
    <StackPanel Margin="18">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="选择游戏目录" />
        <TextBlock Style="{StaticResource PlaceholderText}" Margin="0,8,0,0"
                   Text="下面是扫描到的候选（点一条选中），也可以手动输入或用「浏览…」自己挑。&#x0a;要选的是游戏根目录 —— 也就是里面有 data 文件夹、data 里有一堆 .pack 的那一层。&#x0a;用途：读原版表（精英解锁 / 引用体检）、生成依赖缓存、导出 .pack。现在不选也行，之后在左下「全局选项」里能随时设。" />

        <TextBlock Margin="10,10,0,4" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                   Text="扫描到的候选" />
        <Border BorderBrush="{DynamicResource Border.Line}" BorderThickness="1"
                Background="{DynamicResource Bg.Panel}" Height="170">
            <ListBox x:Name="LstCandidates" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Text.Primary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,0">
                                <TextBlock.Text>
                                    <Binding Path="Mark" />
                                </TextBlock.Text>
                                <TextBlock.Foreground>
                                    <Binding Path="MarkBrush" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Path=Path}" TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding Note}" FontSize="11"
                                           Foreground="{DynamicResource Text.Secondary}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <TextBlock x:Name="TxtScanNote" Margin="10,4,0,0" FontSize="11"
                   Foreground="{DynamicResource Text.Secondary}" />

        <TextBlock Margin="10,10,0,4" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                   Text="手动输入 / 浏览" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtManual" Grid.Column="0" Padding="4,3" Height="28"
                     Background="{DynamicResource Bg.Panel}"
                     Foreground="{DynamicResource Text.Primary}"
                     BorderBrush="{DynamicResource Border.Line}"
                     TextChanged="OnManualChanged" />
            <Button Grid.Column="1" Content="浏览…" Padding="12,4" Margin="8,0,0,0" Click="OnBrowse" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="跳过（稍后设置）" Padding="12,4" Margin="0,0,8,0" Click="OnSkip" />
            <Button Content="用这个目录" Padding="12,4" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
