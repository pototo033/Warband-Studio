<Window x:Class="WarbandStudio.Ui.Views.ProjectPacksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程内的包" Width="720" Height="420" MinWidth="520" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="工程内的包（识别清单）" />
            <TextBlock Style="{StaticResource PlaceholderText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="勾上的 = 已识别：下次「打开工程」时会自动一起打开；没勾的不会自动开（随时可以再勾）。&#x0a;确定后新勾上的会立刻打开；取消勾选的不主动关（下次打开工程起生效）。" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="全选" Padding="12,4" Margin="0,0,8,0" Click="OnCheckAll" />
            <Button Content="全不选" Padding="12,4" Margin="0,0,8,0" Click="OnCheckNone" />
            <Button Content="确定" Padding="12,4" Margin="0,0,8,0" Click="OnOk" IsDefault="True" />
            <Button Content="取消" Padding="12,4" IsCancel="True" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource Border.Line}" BorderThickness="1"
                Background="{DynamicResource Bg.Panel}" Margin="0,10,0,0">
            <ListBox x:Name="Lst" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Text.Primary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Checked, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Secondary}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
