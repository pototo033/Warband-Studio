<Window x:Class="WarbandStudio.Ui.Views.TourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用教程" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{DynamicResource AppFont}" FontSize="12">
    <Grid x:Name="RootGrid">
        <!-- 指向目标的高亮框（跟着当前步骤移动） -->
        <Border x:Name="Spot" BorderBrush="#64A9E2" BorderThickness="2.5" CornerRadius="6"
                Background="#2064A9E2" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <!-- 说明卡片 -->
        <Border x:Name="Card" Width="430" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#F21B1E21" BorderBrush="#464E56" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="StepNo" DockPanel.Dock="Right" Foreground="#8A929A" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="Title" Foreground="#E2B45F" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock x:Name="Body" Foreground="#E6E8EA" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="BtnPrev" Content="上一步" Padding="10,3" Margin="0,0,8,0" Click="OnPrev" />
                    <Button x:Name="BtnSkip" Content="跳过教程" Padding="10,3" Margin="0,0,8,0" Click="OnSkip" />
                    <Button x:Name="BtnNext" Content="确定" Padding="14,3" Click="OnNext" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
