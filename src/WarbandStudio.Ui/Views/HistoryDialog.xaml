<Window x:Class="WarbandStudio.Ui.Views.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史版本" Width="780" Height="460" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="历史版本（每次保存前的自动备份）" />
            <TextBlock x:Name="TxtSub" Style="{StaticResource PlaceholderText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="打开历史文件夹" Padding="12,4" Margin="0,0,8,0" Click="OnOpenFolder" />
            <Button Content="刷新" Padding="12,4" Margin="0,0,8,0" Click="OnRefresh" />
            <Button Content="还原到所选…" Padding="12,4" Margin="0,0,8,0" Click="OnRestore" IsDefault="True" />
            <Button Content="关闭" Padding="12,4" IsCancel="True" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource Border.Line}" BorderThickness="1"
                Background="{DynamicResource Bg.Panel}" Margin="0,10,0,0">
            <ListBox x:Name="Lst" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Text.Primary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     MouseDoubleClick="OnRestore">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding File}" TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="1" Text="{Binding When}"
                                       Foreground="{DynamicResource Text.Secondary}" />
                            <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Text.Secondary}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
