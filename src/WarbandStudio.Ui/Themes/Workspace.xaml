<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工作台排版单独维护，基础控件仍由 Controls.xaml 统一提供。 -->
    <Style x:Key="Workspace.ToolbarLabel" TargetType="TextBlock" BasedOn="{StaticResource AeText.Caption}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="Workspace.ToolbarDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="{DynamicResource AeBrush.Border}" />
        <Setter Property="Margin" Value="6,3,14,3" />
    </Style>
</ResourceDictionary>
